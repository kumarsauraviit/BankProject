# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Neon PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL=

# Frontend URL for Password Reset Links
FRONTEND_URL=http://localhost:3000

# Redis Configuration (for BullMQ queues)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Alternatively, provide a full Redis connection string:
# REDIS_URL=redis://default:password@127.0.0.1:6379

# SMTP Email Configuration
# Use port 465 with SMTP_SECURE=true, or port 587 with SMTP_SECURE=false.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Auth Service <no-reply@example.com>"

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1h
